{
  "manifest_version": 3,
  "name": "CIVION Mail",
  "version": "0.6.9",
  "description": "Local-first Thunderbird runtime with intelligent PDF classification, automatic new-mail archival and controlled all-account archival of existing documents to the validated CIVION archive on drive F:.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-sentinel@local.invalid",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesDelete",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "storage",
    "menus",
    "downloads",
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "CIVION Mail — Open controls",
    "default_label": "CIVION Mail",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/index.html",
    "allowed_spaces": [],
    "default_windows": [
      "normal",
      "messageDisplay"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+M"
      },
      "description": "Open CIVION Mail controls"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-src 'none'"
  },
  "message_display_action": {
    "default_title": "CIVION Mail — Analyze this message",
    "default_label": "CIVION Mail",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/index.html"
  },
  "options_ui": {
    "page": "action-center/index.html",
    "open_in_tab": true
  }
}
